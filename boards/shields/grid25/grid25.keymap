// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    combos {
        compatible = "zmk,combos";



        combo_bootloader {
            timeout-ms = <50>;
            require-prior-idle-ms = <50>;
            key-positions = <0 1>;
            bindings = <&bootloader>;
        };
    };


    // 蓝牙清空
macros {
        // ====== 设备 0 ======
        macro_bt_sel_0: macro_bt_sel_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>;
        };
        macro_bt_clr_0: macro_bt_clr_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            bindings = <&bt BT_SEL 0>, <&bt BT_CLR>;
        };

        // ====== 设备 1 ======
        macro_bt_sel_1: macro_bt_sel_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>;
        };
        macro_bt_clr_1: macro_bt_clr_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            bindings = <&bt BT_SEL 1>, <&bt BT_CLR>;
        };

        // ====== 设备 2 ======
        macro_bt_sel_2: macro_bt_sel_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>;
        };
        macro_bt_clr_2: macro_bt_clr_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            bindings = <&bt BT_SEL 2>, <&bt BT_CLR>;
        };
    };
    behaviors {
        ht_bt_0: ht_bt_0 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>; // 强制改为 2
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            bindings = <&macro_bt_clr_0>, <&macro_bt_sel_0>; 
        };

        ht_bt_1: ht_bt_1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>; // 强制改为 2
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            bindings = <&macro_bt_clr_1>, <&macro_bt_sel_1>;
        };

        ht_bt_2: ht_bt_2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>; // 强制改为 2
            flavor = "hold-preferred";
            tapping-term-ms = <250>;
            bindings = <&macro_bt_clr_2>, <&macro_bt_sel_2>;
        };
    };

    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC  &lt (1) LC(X)  &kp LC(C)  &kp LC(V)  &kp BACKSPACE  &kp N7  &kp N8  &kp N9  &kp HOME  &kp PG_UP  &kp NUMBER_4  &kp N5  &kp NUMBER_6  &kp END  &kp PG_DN  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp UP_ARROW  &kp ENTER  &kp SPACE  &kp N0  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&to 0  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &ht_bt_0 0 0  &ht_bt_1 0 0  &ht_bt_2 0 0  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD
            >;
        };
    };
};
